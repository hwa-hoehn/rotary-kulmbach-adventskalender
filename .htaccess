ErrorDocument 404 /404.html

# Immer HTTPS auf der echten Domain. Bewusst ohne RewriteRule: IONOS erlaubt hier keine Symlinks,
# und dann blockiert Apache jede RewriteRule mit 403. Die IONOS-Testadresse bleibt ohne Umleitung erreichbar.
<If "%{HTTP_HOST} =~ /rotaryclub-kulmbach\.de$/i && %{HTTPS} != 'on' && %{HTTP:X-Forwarded-Proto} != 'https'">
  Redirect permanent "https://%{HTTP_HOST}%{REQUEST_URI}"
</If>

# Alte Adressen der früheren Baukasten-Seite (stehen noch bei Google) auf die passende Stelle umleiten
RedirectMatch 301 ^/wo-kann-ich-ein-kalenderlos-kaufen/?$ /#lose
RedirectMatch 301 ^/wo-bekomme-ich-meinen-preis/?$ /#hotline
RedirectMatch 301 ^/so-funktioniert-die-verlosung/?$ /#verlosung
RedirectMatch 301 ^/sponsoren/?$ /#sponsoren
RedirectMatch 301 ^/(aktuelle-hilfsprojekte|wem-kommen-die-erl.*se-zu-gute)/?$ /#erloese
RedirectMatch 301 ^/(rotary-club-kulmbach-stellt-sich-vor|die-projektverantwortlichen)/?$ /#club
RedirectMatch 301 ^/(startseite|sitemap)/?$ /
RedirectMatch 301 ^/impressum/?$ /impressum.html
RedirectMatch 301 ^/datenschutz/?$ /datenschutz.html

# Interne Dateien nicht ausliefern (privat/ und werkzeuge/ haben zusätzlich eine eigene Sperre)
RedirectMatch 404 /(privat|werkzeuge|src)(/|$)
RedirectMatch 404 /\.git
<Files ".ht*">
  Require all denied
</Files>
<FilesMatch "\.(py|part|md|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  <Files "verwaltung.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  </Files>
</IfModule>

# Kompression und Zwischenspeicher (CSS/JS haben ?v= in der Adresse und dürfen lange gespeichert werden)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
